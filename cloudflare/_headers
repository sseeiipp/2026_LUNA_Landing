# nginx/default.conf.template, nginx/security-headers.conf 와 같은 헤더를 Cloudflare Pages에서 붙인다.
# HTML 등 아래에 없는 파일은 Pages 기본값(max-age=0, must-revalidate)이라 배포 즉시 반영된다.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://qmevafndcgcrzpjcitxc.supabase.co https://i.ytimg.com; font-src 'self'; connect-src 'self' data: blob: https://qmevafndcgcrzpjcitxc.supabase.co; worker-src 'self' blob:; frame-src 'self' blob: https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

# 라이브러리, 폰트, 3D 모델은 버전이 경로에 들어 있어 내용이 바뀌지 않는다.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/model/*
  Cache-Control: public, max-age=31536000, immutable

# css/js는 build.sh가 모든 주소에 ?v=(내용 해시)를 붙이므로 1년 캐시해도 바뀌면 바로 새 파일을 받는다.
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=2592000
/logo/*
  Cache-Control: public, max-age=2592000
/icon/*
  Cache-Control: public, max-age=2592000
