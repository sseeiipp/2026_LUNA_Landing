server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml application/octet-stream;

    # 라이브러리와 폰트는 버전이 경로에 들어 있어 내용이 바뀌지 않는다.
    location ~ ^/(vendor|fonts|model)/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~ ^/(img|logo|icon)/ {
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    # HTML/CSS/JS/데이터는 배포 즉시 반영되도록 매번 재검증한다.
    location / {
        add_header Cache-Control "no-cache";
        # /award, /project 같은 확장자 없는 링크도 열리게 한다.
        try_files $uri $uri.html $uri/ =404;
    }
}
